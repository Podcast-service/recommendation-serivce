RECOMMENDATION_BUILD_CONTEXT=.
RECOMMENDATION_CONTAINER_NAME=recommendation-service
RECOMMENDATION_POSTGRES_IMAGE=postgres:18-alpine
RECOMMENDATION_POSTGRES_CONTAINER_NAME=recommendation-postgres

RECOMMENDATION_SERVER_PORT=8083
RECOMMENDATION_DB_PORT=15433
RECOMMENDATION_DB_NAME=recommendation_db
RECOMMENDATION_DB_USER=recommendation_user
RECOMMENDATION_DB_PASSWORD=recommendation_pass
RECOMMENDATION_DB_URL=jdbc:postgresql://postgres:5432/recommendation_db

RECOMMENDATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RECOMMENDATION_KAFKA_CONSUMERS_ENABLED=false
RECOMMENDATION_KAFKA_CONSUMER_GROUP=recommendation-service
RECOMMENDATION_KAFKA_CONCURRENCY=1
RECOMMENDATION_KAFKA_MAX_POLL_RECORDS=100
RECOMMENDATION_KAFKA_RETRY_ATTEMPTS=5
RECOMMENDATION_KAFKA_RETRY_BACKOFF_MS=1000
RECOMMENDATION_KAFKA_DLT_ENABLED=true
RECOMMENDATION_KAFKA_TOPIC_PODCAST_ACTIVITY_EVENTS=podcast.activity.events.v1
RECOMMENDATION_KAFKA_TOPIC_PODCAST_CONTENT_EVENTS=podcast.content.events.v1
RECOMMENDATION_KAFKA_TOPIC_PODCAST_SEARCH_EVENTS=podcast.search.events.v1
RECOMMENDATION_KAFKA_DLT_TOPIC_PODCAST_ACTIVITY_EVENTS=podcast.activity.events.v1.DLT
RECOMMENDATION_KAFKA_DLT_TOPIC_PODCAST_CONTENT_EVENTS=podcast.content.events.v1.DLT
RECOMMENDATION_KAFKA_DLT_TOPIC_PODCAST_SEARCH_EVENTS=podcast.search.events.v1.DLT

# JWT secret must come from secret storage outside local development.
# RECOMMENDATION_JWT_SECRET may use the same value as Podcast Core PODCAST_ACCESS_TOKEN_SECRET.
RECOMMENDATION_SECURITY_ENABLED=true
RECOMMENDATION_JWT_SECRET=
RECOMMENDATION_JWT_ISSUER=auth-service
RECOMMENDATION_PROMETHEUS_PUBLIC=false
RECOMMENDATION_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8083

RECOMMENDATION_TRENDS_API_ENABLED=true
RECOMMENDATION_PERSONAL_PODCASTS_API_ENABLED=true
RECOMMENDATION_BLOCKS_API_ENABLED=true
RECOMMENDATION_REFRESH_JOB_ENABLED=false
RECOMMENDATION_GLOBAL_JOB_ENABLED=false
RECOMMENDATION_CACHE_CLEANUP_ENABLED=false
RECOMMENDATION_SWAGGER_ENABLED=true

RECOMMENDATION_PERSONAL_CACHE_TTL=PT30M
RECOMMENDATION_GLOBAL_CACHE_TTL=PT10M
RECOMMENDATION_REFRESH_USER_LIMIT=100
RECOMMENDATION_REFRESH_JOB_FIXED_DELAY_MS=1200000
RECOMMENDATION_GLOBAL_JOB_FIXED_DELAY_MS=600000
RECOMMENDATION_CACHE_CLEANUP_FIXED_DELAY_MS=3600000
